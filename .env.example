# LEAP Environment Variables
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# Groq AI API (used by services/gemini.ts)
GROK_API_KEY=

# Neon PostgreSQL (used by services/db.js)
NEXT_PUBLIC_DATABASE_URL=

# YouTube Data API v3 (used by services/youtube.ts)
NEXT_PUBLIC_YOUTUBE_API_KEY=

# Gmail SMTP (used by api/sendCertificate)
GMAIL_USER=
GMAIL_APP_PASSWORD=

# NextAuth Authentication
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your_super_secret_string_here
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Gemini API (used by services/gemini.ts for embeddings)
NEXT_PUBLIC_GEMINI_API_KEY=

# Playwright E2E Testing (optional - for authenticated tests)
TEST_USER_EMAIL=
TEST_USER_PASSWORD=
